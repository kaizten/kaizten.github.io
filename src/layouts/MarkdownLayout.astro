---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const { title = "Kaizten Analytics" } = Astro.props;
---

<BaseLayout title={title}>
  <SiteHeader />
  <main>
    <article class="markdown-page">
      <p class="eyebrow">Kaizten Analytics</p>
      <slot />
    </article>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const copyCode = async (button: HTMLButtonElement, code: HTMLElement) => {
    const text = code.textContent ?? "";

    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const selection = window.getSelection();
      const range = document.createRange();
      range.selectNodeContents(code);
      selection?.removeAllRanges();
      selection?.addRange(range);
      document.execCommand("copy");
      selection?.removeAllRanges();
    }

    button.textContent = "Copied";
    window.setTimeout(() => {
      button.textContent = "Copy";
    }, 1600);
  };

  document.querySelectorAll<HTMLElement>(".markdown-page pre").forEach((pre) => {
    const code = pre.querySelector("code");
    if (!code) return;

    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-code-button";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy code to clipboard");
    button.addEventListener("click", () => copyCode(button, code));
    pre.append(button);
  });
</script>
