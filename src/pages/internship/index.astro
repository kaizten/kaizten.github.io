---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIndex from "../../components/SectionIndex.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getSection, titleFromSlug } from "../../data/sections";

const base = import.meta.env.BASE_URL;
const section = getSection("internship");
const pages = section.pages.map((slug) => ({
  title: titleFromSlug(slug),
  url: `${base}${section.slug}/${slug}/`,
}));
---

<BaseLayout title="Internship | Kaizten Analytics">
  <SiteHeader />
  <main>
    <section class="section-page tools-page" aria-labelledby="page-title">
      <p class="eyebrow">Kaizten Analytics</p>
      <h1 id="page-title">Internship</h1>
      <ul>
        <li><a href="https://www.ull.es">Universidad de La Laguna</a></li>
        <li><a href="https://www.ulpgc.es">Universidad de Las Palmas de Gran Canaria</a></li>
        <li><a href="https://www.unir.es">Universidad Internacional de La Rioja</a></li>
      </ul>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
