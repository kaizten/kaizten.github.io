---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { internships } from "../../data/internships";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Internship | Kaizten Analytics">
  <SiteHeader />
  <main>
    <section class="section-page tools-page" aria-labelledby="page-title">
      <p class="eyebrow">Kaizten Analytics</p>
      <h1 id="page-title">Internship</h1>

      <div class="card-grid" aria-label="Internship institutions">
        {
          internships.map((institution) => (
            <Card
              icon={institution.icon}
              title={institution.title}
              description={institution.description}
              href={`${base}internship/${institution.slug}/`}
              buttonHref={institution.websiteUrl}
              buttonIcon="WEB"
              buttonText="Website"
            />
          ))
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
