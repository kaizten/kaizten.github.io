---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { sections } from "../data/sections";

const base = import.meta.env.BASE_URL;
const links = sections
  .filter((section) => section.showInMenu)
  .map((section) => ({ href: `${base}${section.slug}/`, label: section.label }));
---

<BaseLayout>
  <SiteHeader />
  <main>
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-content">
        <p class="eyebrow">GitHub Page</p>
        <h1 id="page-title">Kaizten Analytics</h1>
        <nav class="link-grid" aria-label="Kaizten Analytics sections">
          {
            links.map((link) => (
              <a class="section-link" href={link.href}>
                <span>{link.label}</span>
                <span aria-hidden="true"></span>
              </a>
            ))
          }
        </nav>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
