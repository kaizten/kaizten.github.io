---
import MarkdownLayout from "../../layouts/MarkdownLayout.astro";
import { developmentToc } from "../../data/development";

const base = import.meta.env.BASE_URL;

function escapeHtml(value: string): string {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}

function renderToc(nodes): string {
  return `<ul>${nodes
    .map((node) => {
      const label = escapeHtml(node.title);
      const entry = node.href
        ? `<a href="${base}${escapeHtml(node.href)}">${label}</a>`
        : `<span>${label}</span>`;
      const children = node.children.length > 0 ? renderToc(node.children) : "";

      return `<li>${entry}${children}</li>`;
    })
    .join("")}</ul>`;
}
---

<MarkdownLayout title="Development | Kaizten Analytics">
  <h1>Development</h1>
  <h2>Table of contents</h2>
  <Fragment set:html={renderToc(developmentToc)} />
</MarkdownLayout>
