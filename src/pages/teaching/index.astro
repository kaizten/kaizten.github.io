---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionIndex from "../../components/SectionIndex.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getSection, titleFromSlug } from "../../data/sections";

const base = import.meta.env.BASE_URL;
const section = getSection("teaching");
const pages = section.pages.map((slug) => ({
  title: titleFromSlug(slug),
  url: `${base}${section.slug}/${slug}/`,
}));
---

<BaseLayout title="Teaching | Kaizten Analytics">
  <SiteHeader />
  <main>
    <SectionIndex title="Teaching" pages={pages} />
  </main>
  <SiteFooter />
</BaseLayout>
