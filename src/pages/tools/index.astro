---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { tools } from "../../data/tools";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Tools | Kaizten Analytics">
  <SiteHeader />
  <main>
    <section class="section-page tools-page" aria-labelledby="page-title">
      <p class="eyebrow">Kaizten Analytics</p>
      <h1 id="page-title">Tools</h1>

      <div class="card-grid" aria-label="Tools content">
        {
          tools.map((tool) => (
            <Card
              icon={tool.icon}
              title={tool.title}
              description={tool.description}
              href={`${base}tools/${tool.slug}/`}
              buttonHref={tool.repositoryUrl}
              buttonIconSrc={`${base}assets/icons/github.svg`}
              buttonText="GitHub"
            />
          ))
        }
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
